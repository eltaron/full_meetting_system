APP_NAME="بوابة محافظة كفر الشيخ الموحدة"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kfs_portal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@kfs.gov.eg"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
MEDIA_DISK=local

# ===== هوية المنظومة =====
KFS_ORGANIZATION="محافظة كفر الشيخ"
KFS_SYSTEM_NAME="المنظومة الإدارية الموحدة"
ARCHIVE_NUMBER_PREFIX=KFS

# ===== تفعيل / إيقاف الأنظمة الفرعية =====
MODULE_ARCHIVE=true
MODULE_FOLLOWUP=true
MODULE_MEETINGS=true
